# Environment for the Cloud Run deployment of the backend.
#
#   cp cloudrun.env.yaml.example cloudrun.env.yaml
#   # edit the three placeholders below
#   gcloud run deploy vedalex-api --source . --dockerfile Dockerfile.lite \
#       --env-vars-file cloudrun.env.yaml ...
#
# cloudrun.env.yaml is git-ignored, so your real key never reaches the repo.
#
# A YAML file is used rather than --set-env-vars because gcloud splits that
# flag on commas, and CORS_ORIGINS is a JSON array that contains commas.
# CORS_ORIGINS must stay JSON: the field is typed list[str] and pydantic-settings
# JSON-parses it, so a comma-separated string fails validation at startup.

# --- ML stack off: keeps the container in the measured 183 MB "lite" mode -----
IPSAKTI_USE_BGE_M3: "0"
IPSAKTI_USE_RERANKER: "0"

# Cloud Run wipes the filesystem between instances, so the embedded Qdrant
# store lives under /tmp and scripts/serve.py rebuilds it on every cold start.
QDRANT_LOCAL_PATH: "/tmp/qdrant"

# --- LLM ---------------------------------------------------------------------
IPSAKTI_LLM_MODEL: "gemini-3.5-flash"
# Rotated key from https://aistudio.google.com/apikey
GEMINI_API_KEY: "PASTE_YOUR_ROTATED_KEY_HERE"

# --- Auth --------------------------------------------------------------------
# Generate ONE value and never change it: it signs every session JWT, so a
# new value on each deploy silently logs everybody out. On Render this was
# generated for you (generateValue: true); on Cloud Run you supply it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_API_KEY_SECRET: "PASTE_A_RANDOM_48_CHAR_SECRET_HERE"

# --- CORS --------------------------------------------------------------------
# Your Vercel URL, exactly, no trailing slash. The browser talks only to the
# Vercel origin (next.config.js proxies /api/v1 server-side), so this is just
# defence in depth for direct API calls.
CORS_ORIGINS: ["https://your-app.vercel.app"]
