# IP-SAKTI Sahayak Backend Environment Configuration
PROJECT_NAME="IP-SAKTI Sahayak"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS
CORS_ORIGINS=["http://localhost:3000","https://ipsakti.in"]

# Database (PostgreSQL - fallback to SQLite if unavailable)
# DATABASE_URL="postgresql://ipsakti:ipsakti_secret@localhost:5432/ipsakti"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ipsakti"

# JWT Authentication
SECRET_KEY="ipsakti_secure_production_secret_key_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DPDP Act 2023 Compliance
GRIEVANCE_OFFICER_NAME="Aditya Sharma (Compliance Lead)"
GRIEVANCE_OFFICER_EMAIL="grievance@ipsakti.in"
DATA_LOCALIZATION_REGION="ap-south-1 (Mumbai, India)"

# Secret API Key (Strictly backend only)
BACKEND_API_KEY_SECRET="ipsakti_secure_production_secret_key_2026"

# ─── RAG Pipeline Configuration ───────────────────────────────────────────────

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY=""  # Uncomment for Qdrant Cloud

# Embeddings — BGE-M3 (open-source, multilingual, 1024-dim, default)
IPSAKTI_USE_BGE_M3=1
IPSAKTI_EMBEDDING_MODEL="BAAI/bge-m3"
# OPENAI_API_KEY=""  # Uncomment for OpenAI text-embedding-3-large fallback

# Reranker — BGE Reranker v2 M3 (cross-encoder)
IPSAKTI_USE_RERANKER=1
IPSAKTI_RERANKER_MODEL="BAAI/bge-reranker-v2-m3"