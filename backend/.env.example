# IP-SAKTI Sahayak Backend Environment Configuration
PROJECT_NAME="IP-SAKTI Sahayak"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS — allow-list of browser origins (NO "*" — wildcard defeats credentials)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://ipsakti.in"]

# Database (PostgreSQL - fallback to SQLite if unavailable)
# DATABASE_URL="postgresql://ipsakti:ipsakti_secret@localhost:5432/ipsakti"
DATABASE_URL=""

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DPDP Act 2023 Compliance
GRIEVANCE_OFFICER_NAME="Aditya Sharma (Compliance Lead)"
GRIEVANCE_OFFICER_EMAIL="grievance@ipsakti.in"
DATA_LOCALIZATION_REGION="ap-south-1 (Mumbai, India)"

# Secret API Key (Strictly backend only)
# Empty value auto-generates a per-process random key; SET this in production.
BACKEND_API_KEY_SECRET=""

# ─── Bhashini Translation (AI4Bharat) ─────────────────────────────────────────
# Enables Hindi/Tamil/… query → English retrieval and answer translation back.
# Leave unset to fall back to the regex/glossary translation layer.
# Get credentials at https://bhashini.gov.in/ (ULCA onboarding).
# IPSAKTI_BHASHINI_API_KEY=""
# IPSAKTI_BHASHINI_USER_ID=""
# IPSAKTI_BHASHINI_API_URL="https://api.bhashini.gov.in/v1/model/compute"

# ─── RAG Pipeline Configuration ───────────────────────────────────────────────

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY=""  # Uncomment for Qdrant Cloud

# Embeddings — BGE-M3 (open-source, multilingual, 1024-dim, default)
IPSAKTI_USE_BGE_M3=1
IPSAKTI_EMBEDDING_MODEL="BAAI/bge-m3"
# OPENAI_API_KEY=""  # Uncomment for OpenAI text-embedding-3-large fallback

# Reranker — BGE Reranker v2 M3 (cross-encoder)
IPSAKTI_USE_RERANKER=1
IPSAKTI_RERANKER_MODEL="BAAI/bge-reranker-v2-m3"

# ─── RAG Architecture Select (Hybrid / Production / Graph / Agentic) ────────
# Default RAG type used by POST /rag/search when no rag_type is supplied.
# Options: hybrid | production | graph | agentic
IPSAKTI_RAG_DEFAULT="hybrid"
# Result-cache lifetime in seconds (ProductionRAG, Redis or in-memory fallback).
IPSAKTI_RAG_CACHE_TTL=3600
# Maximum searches per user per minute (ProductionRAG rate limit).
IPSAKTI_RAG_RATE_LIMIT=60
# Redis for query cache + rate limiting. Leave unset to use in-memory fallbacks.
# REDIS_URL="redis://localhost:6379/0"

# ─── Graph RAG (optional, see backend/app/services/rag/graph_rag.py) ─────────
# The GraphRAG wrapper defaults to the built-in local knowledge graph
# (backend/app/rag/knowledge_graph.py). Set the four vars below to ALSO query
# a Neo4j knowledge graph when the local graph has no matches.
# NEO4J_URI="bolt://localhost:7687"
# NEO4J_USER="neo4j"
# NEO4J_PASSWORD="change-me"

# ─── LLM Generation (draft answers) ─────────────────────────────────────────
# IPSAKTI_LLM_PROVIDER: auto | gemini | openai | mock | off
#   auto   — Gemini if GEMINI_API_KEY set, else OpenAI if OPENAI_API_KEY set, else off
#   mock   — deterministic source summary (no network, for offline demo)
#   off    — deterministic pipeline only
IPSAKTI_LLM_PROVIDER="auto"
# IPSAKTI_LLM_MODEL="gemini-2.0-flash"   # override model name per provider
# IPSAKTI_LLM_TIMEOUT="25"               # generation timeout in seconds
# GEMINI_API_KEY=""                      # https://aistudio.google.com/apikey
# OPENAI_API_KEY=""                      # or use OpenAI as the generator

# ─── Live Official-Website Retrieval ────────────────────────────────────────
# Set 0 to disable network fetching and rely purely on the local knowledge base.
IPSAKTI_LIVE_WEB=1
# IPSAKTI_WEB_TIMEOUT="8"                # per-request HTTP timeout (sec)
# IPSAKTI_WEB_CACHE_TTL="21600"          # per-URL cache lifetime (sec, 6h)
# IPSAKTI_WEB_MAX_FETCHES="3"            # http fetches per query